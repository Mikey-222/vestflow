# HTTP port the API listens on.
PORT=4000

# Interface to bind. Keep 0.0.0.0 in containers, 127.0.0.1 for local dev.
HOST=0.0.0.0

# "development" | "production" | "test"
NODE_ENV=development

# Stellar network passphrase: "Test SDF Network ; September 2015" or
# "Public Global Stellar Network ; September 2015".
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Soroban RPC endpoint used for all contract reads.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# VestFlow contract id (C...) to serve reads for.
VESTFLOW_CONTRACT_ID=

# Comma-separated list of allowed browser origins, or "*" for any.
CORS_ORIGIN=*

# Per-IP request ceiling for the whole router, and the window in ms.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Set to "1" to trust X-Forwarded-For (only enable behind a proxy that sets it).
TRUST_PROXY=0

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
